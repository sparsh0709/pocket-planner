{
  "id": "./",
  "name": "Pocket Planner",
  "short_name": "Pocket Planner",
  "description": "A quick expense and budget tracker for university students.",
  "lang": "en-IN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F3F6F5",
